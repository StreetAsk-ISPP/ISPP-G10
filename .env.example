# StreetAsk Environment Variables
# Copy this file to .env and fill in your values
# Usage: docker-compose up -d

# ===================
# MySQL Configuration
# ===================
# Root password for MySQL (only used locally)
MYSQL_ROOT_PASSWORD=rootpassword

# Database name
MYSQL_DATABASE=streetask

# Database user credentials
MYSQL_USER=streetask
MYSQL_PASSWORD=streetask

# ===================
# Brevo SMTP (Email)
# ===================
# SMTP server and port
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587

# SMTP credentials from Brevo
BREVO_SMTP_USERNAME=check-drive-credentials-file
BREVO_SMTP_PASSWORD=check-drive-credentials-file

# From address used by the app
BREVO_MAIL_FROM=streetask0@gmail.com

# ===================
# Stripe Payments
# ===================
# Secret key (server-side). Required to create/confirm checkout sessions.
STRIPE_SECRET_KEY=

# Publishable key (frontend-safe). Returned by API for compatibility.
STRIPE_PUBLISHABLE_KEY=

# Currency for Stripe line items (ISO code, lowercase recommended).
# Examples: eur, usd, gbp
STRIPE_CURRENCY=eur

# Business subscription amount in cents.
# Example: 1999 => 19.99 EUR/USD
STRIPE_SUBSCRIPTION_AMOUNT_CENTS=1999

# Regular user premium amount in cents.
# Example: 999 => 9.99 EUR/USD
STRIPE_REGULAR_PREMIUM_AMOUNT_CENTS=999

# Redirect URL after successful Stripe payment.
# The backend appends query params automatically:
#   ?payment=success&session_id={CHECKOUT_SESSION_ID}
# In local web dev, frontend usually runs on http://localhost:8081
STREETASK_STRIPE_SUCCESS_URL=http://localhost:8081

# Redirect URL when user cancels Stripe checkout.
# The backend appends: ?payment=cancel
STREETASK_STRIPE_CANCEL_URL=http://localhost:8081

# ===================
# Azure Production (Optional - for reference)
# ===================
# When deploying to Azure, set these in Azure App Service configuration:
# MYSQL_URL=jdbc:mysql://your-azure-mysql.mysql.database.azure.com:3306/streetask?useSSL=true&requireSSL=true
# MYSQL_USER=your-azure-user@your-azure-mysql
# MYSQL_PASSWORD=your-azure-password
